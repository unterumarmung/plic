module(
    name = "dola",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_java", version = "9.1.0")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "llvm", version = "0.7.7")
bazel_dep(name = "rules_rs", version = "0.0.61")
bazel_dep(name = "googletest", version = "1.17.0")
bazel_dep(name = "aspect_rules_lint", version = "2.7.2")
bazel_dep(name = "rules_go", version = "0.60.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "bazel_skylib", version = "1.9.0")

single_version_override(
    module_name = "llvm",
    patch_strip = 1,
    patches = [
        "//bazel/patches:hermetic-llvm-lit.patch",
        "//bazel/patches:hermetic-llvm-native-targets.patch",
    ],
    version = "0.7.7",
)

single_version_override(
    module_name = "googletest",
    patch_strip = 1,
    patches = ["//bazel/patches:googletest-bazel9.patch"],
    version = "1.17.0",
)

llvm_project = use_extension("@llvm//extensions:llvm.bzl", "llvm")
llvm_project.configure(targets = [
    "AArch64",
    "X86",
])
use_repo(llvm_project, "llvm-project")

rust = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rust.toolchain(
    edition = "2024",
    version = "1.92.0",
)
use_repo(rust, "default_rust_toolchains")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.13")
use_repo(python, "python_3_13")

register_toolchains(
    "@default_rust_toolchains//:all",
    "@llvm//toolchain:all",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_archive(
    name = "antlr4",
    build_file = "//bazel:antlr4.BUILD.bazel",
    integrity = "sha256-nxgnKpsytiKDWjNl+FDdEGPWD1BF+x4Szkda5uGKNbs=",
    strip_prefix = "antlr4-4.13.2",
    type = "tar.gz",
    urls = [
        "https://codeload.github.com/antlr/antlr4/tar.gz/refs/tags/4.13.2",
        "https://github.com/antlr/antlr4/archive/refs/tags/4.13.2.tar.gz",
    ],
)

http_file(
    name = "antlr4_tool",
    downloaded_file_path = "antlr-4.13.2-complete.jar",
    integrity = "sha256-6uLfoRmmQydERnKv9j6ew1ogGA3FuAkLemq4USXfTXY=",
    urls = [
        "https://repo1.maven.org/maven2/org/antlr/antlr4/4.13.2/antlr4-4.13.2-complete.jar",
        "https://www.antlr.org/download/antlr-4.13.2-complete.jar",
    ],
)
