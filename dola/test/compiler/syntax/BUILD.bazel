load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:lit.bzl", "lit_test_suite")

filegroup(
    name = "format_sources",
    srcs = glob(["*.cpp", "*.h"], allow_empty = True),
    visibility = ["//visibility:public"],
)

cc_test(
    name = "syntax_test",
    srcs = ["syntax_test.cpp"],
    deps = [
        "//compiler/support",
        "//compiler/syntax",
        "@googletest//:gtest_main",
    ],
    visibility = ["//:__pkg__"],
)

lit_test_suite(
    name = "lit_tests",
    srcs = [
        "ast.dola",
        "invalid_postfix.dola",
        "literal_overflow.dola",
        "malformed_constructor.dola",
        "malformed_loop.dola",
        "malformed_type.dola",
        "missing_module.dola",
    ],
    cfg = "//test:lit.cfg.py",
    tools = [
        "//tools/dola",
        "@llvm-project//llvm:FileCheck",
    ],
)
