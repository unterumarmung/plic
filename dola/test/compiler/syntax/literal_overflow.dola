// RUN: not dola --check %s 2>&1 | FileCheck --strict-whitespace %s
module syntax.literal_overflow;

fn integer() -> Int {
// CHECK: literal_overflow.dola:[[@LINE+3]]:5: error: integer literal is outside the range of `Int`
// CHECK-NEXT:         9223372036854775808
// CHECK-NEXT:         ^^^^^^^^^^^^^^^^^^^
    9223372036854775808
}

fn floating() -> Float {
// CHECK-NEXT: literal_overflow.dola:[[@LINE+3]]:5: error: floating-point literal is outside the range of `Float`
// CHECK-NEXT:         .0
// CHECK-NEXT:         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
    .0
}

fn tuple_index() {
    let tuple = (1, 2);
// CHECK-NEXT: literal_overflow.dola:[[@LINE+3]]:11: error: tuple field index is outside the supported range
// CHECK-NEXT:         tuple.999999999999999999999999;
// CHECK-NEXT:               ^^^^^^^^^^^^^^^^^^^^^^^^
    tuple.999999999999999999999999;
}
