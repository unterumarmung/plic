load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_python//python:defs.bzl", "py_test")
load("//bazel:dola_rules.bzl", "dola_binary", "dola_library", "dola_test")
load(":dola_compile_failure_test.bzl", "dola_compile_failure_test")

py_test(
    name = "chat_execution_test",
    srcs = [
        "chat_execution_test.py",
        "process_harness.py",
    ],
    args = [
        "$(location //examples/chat:server)",
        "$(location //examples/chat:client)",
    ],
    data = [
        "//examples/chat:client",
        "//examples/chat:server",
    ],
    python_version = "PY3",
    timeout = "short",
)

py_test(
    name = "chat_stress_test",
