[
    dola_binary(
        name = "%s_program" % name,
        srcs = ["%s.dola" % name],
        testonly = True,
    )
    for name in [
        "remainder_by_zero",
        "division_overflow",
    ]
]

[
    sh_test(
        name = "%s_test" % name,
        srcs = ["expect_failure.sh"],
        args = ["$(location :%s_program)" % name],
        data = [":%s_program" % name],
    )
    for name in [
        "remainder_by_zero",
        "division_overflow",
    ]
]
