)

dola_compile_failure_test(
    name = "undeclared_import_compile_test",
    srcs = ["declared_input_main.dola"],
    expected = "unknown module `test.declared_input_dependency`",
)

dola_compile_failure_test(
    name = "declared_import_compile_test",
    srcs = ["declared_input_main.dola"],
    deps = [":declared_input_dependency"],
    should_fail = False,
)

